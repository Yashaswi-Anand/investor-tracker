# ---------------------------------------------------------------------------
# Website environment. Copy to .env.local for local dev.
# In production set these in Vercel -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL (Dashboard -> Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase ANON key (Dashboard -> Settings -> API -> anon public).
# Safe in the browser: RLS restricts it to read-only SELECT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL — used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://investor.socialriser.com

# Where readers can write to you. AdSense will not approve a site with no
# working contact route, and the contact page hides its address until this
# is set rather than printing one that bounces.
NEXT_PUBLIC_CONTACT_EMAIL=

# AdSense publisher id, "pub-0000000000000000". Fills /ads.txt and the
# privacy policy's advertising section.
NEXT_PUBLIC_ADSENSE_ID=

# Set to "true" only once AdSense has approved the site. The disclosure in
# the privacy policy goes up with the id above; this is what actually loads
# their script.
NEXT_PUBLIC_ADS_ENABLED=false
