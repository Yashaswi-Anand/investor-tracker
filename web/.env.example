# ---------------------------------------------------------------------------
# Website environment. Copy to .env.local for local dev.
# In production set these in Vercel -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL (Dashboard -> Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase ANON key (Dashboard -> Settings -> API -> anon public).
# Safe in the browser: RLS restricts it to read-only SELECT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL — used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://investor.socialriser.com

# Where readers can write to you. AdSense will not approve a site with no
# working contact route, and the contact page hides its address until this
# is set rather than printing one that bounces.
NEXT_PUBLIC_CONTACT_EMAIL=

# AdSense publisher id, "pub-0000000000000000". Fills /ads.txt and the
# privacy policy's advertising section.
NEXT_PUBLIC_ADSENSE_ID=

# Set to "true" only once AdSense has approved the site. The disclosure in
# the privacy policy goes up with the id above; this is what actually loads
# their script.
NEXT_PUBLIC_ADS_ENABLED=false

# Google Search Console ownership, from the "HTML tag" verification method:
# copy only the content="..." value, not the whole tag. Leave empty until you
# have one — an empty tag reads as a failed verification, so none is emitted.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ---------------------------------------------------------------------------
# Firebase — Google sign-in only.
#
# Project: investor-ipo-tracker (Firebase console -> Project settings ->
# General -> Your apps -> investor-web -> SDK setup and configuration).
#
# None of these is a secret. A Firebase web apiKey identifies the project to
# Google's endpoints and is designed to ship in client code; what actually
# guards the project is the authorized-domain list under Authentication ->
# Settings. Leave them all empty and sign-in simply does not appear — the
# rest of the site is unaffected.
#
# Like every NEXT_PUBLIC_ value these are baked in at `npm run build`, so
# changing one in hPanel needs a REDEPLOY, not a restart.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
