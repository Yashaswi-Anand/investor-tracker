# ---------------------------------------------------------------------------
# Scraper environment. Copy to .env and fill in. .env is git-ignored.
# ---------------------------------------------------------------------------

# Supabase project URL (Dashboard -> Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# service_role key (Dashboard -> Settings -> API -> service_role).
# A long JWT starting with eyJ... — NOT the database password.
# Write access. Never put this in the website or the app.
SUPABASE_SERVICE_KEY=your-service-role-key

# GMP source: none | investorgain | ipowatch | ipocentral
#   none = disabled. Enter GMP by hand in Supabase and add 'gmp' to the
#          row's `locked` array so the scraper never overwrites it.
GMP_SOURCE=investorgain
GMP_FALLBACKS=ipowatch,ipocentral

# Timetable source: none | investorgain
#   Supplies allotment / refund / demat / listing dates and the registrar.
#   These are the issuer's SCHEDULED dates and can move before allotment.
#   none = disabled. Enter them by hand and add the column names to `locked`.
TIMETABLE_SOURCE=investorgain

# Cap on per-IPO detail-page fetches in a single run.
#   A detail page is requested only for an IPO still missing timetable data,
#   so in steady state this costs nothing. The cap keeps a cold start (many
#   new IPOs at once) spread over several runs instead of arriving as a spike.
TIMETABLE_MAX_FETCHES_PER_RUN=6

# Identify your bot honestly when scraping.
SCRAPER_USER_AGENT=IPOTrackerBot/1.0 (personal IPO dashboard)

# How often scheduler.py runs the pipeline. Production uses the hourly
# cron in .github/workflows/scrape.yml instead.
INTERVAL_MINUTES=60

# Fetch per-IPO detail pages for lot size / face value (1 extra request each).
FETCH_DETAILS=true

# Politeness delay between requests, in seconds.
DELAY_SECONDS=1.5
